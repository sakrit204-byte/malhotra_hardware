{
  "name": "malhotra_enterprise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "lint:copy": "tsx scripts/copy-lint.ts",
    "check": "npm run typecheck && npm run lint && npm run lint:copy && npm run check:migrations",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "prisma migrate reset --force",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio --port 5555 --browser none",
    "db:seed": "tsx prisma/seed/index.ts",
    "images:fetch": "tsx scripts/fetch-images.ts",
    "postinstall": "prisma generate",
    "verify:inquiry": "node --conditions=react-server --import tsx scripts/verify-inquiry.ts",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "verify:auth": "node --conditions=react-server --import tsx scripts/verify-auth.ts",
    "verify:catalogue": "node --conditions=react-server --import tsx scripts/verify-catalogue.ts",
    "verify": "npm run verify:inquiry && npm run verify:auth && npm run verify:catalogue",
    "images:optimise": "node scripts/optimise-images.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-pdf/renderer": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
